# dependencies
/node_modules
/node_modules-reused-link
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

!.env.example
.dev.vars
*.tsbuildinfo

/tests/.export-check.mjs
/supabase/.temp/

/tests/.transport-check.mjs
/node_modules.previous/
node_modules.previous

